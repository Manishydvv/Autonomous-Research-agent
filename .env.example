# ─── Autonomous Research Agent — Local Environment Variables ───────────────────
# Copy this file to .env and fill in your values.
# When USE_AWS_SECRETS=true (or running on ECS), config loads from AWS Secrets Manager.
# When USE_AWS_SECRETS=false (default for local dev), config loads from this .env file.

# ─── Config Source ────────────────────────────────────────────────────────────
# Set to "true" to load config from AWS Secrets Manager instead of .env
USE_AWS_SECRETS=false

# ─── AWS ──────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1

# ─── LLM Provider API Keys ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
GROQ_API_KEY=gsk_your-groq-key-here

# ─── Bedrock Guardrails ──────────────────────────────────────────────────────
# Leave empty to skip guardrails locally. Set real values to test with AWS Bedrock.
# Get these from: AWS Console → Bedrock → Guardrails (or from terraform output)
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=

# ─── Storage Endpoints ───────────────────────────────────────────────────────
# Local Redis (install via: docker run -d -p 6379:6379 redis:7)
REDIS_URL=redis://localhost:6379

# Local PostgreSQL with pgvector (install via: docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres pgvector/pgvector:pg15)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/researchdb

# TensorZero gateway (run locally or use docker)
TENSORZERO_URL=http://localhost:3000

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Leave empty to disable API key authentication (convenient for local dev)
API_KEY=

# ─── LangSmith Observability ─────────────────────────────────────────────────
# Get your key from: https://smith.langchain.com → Profile → API Keys
# Leave empty to disable tracing
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=research-agent
LANGSMITH_DATASET=research-agent-reports

# ─── Semantic Cache Tuning ────────────────────────────────────────────────────
CACHE_TTL=3600
CACHE_SIMILARITY_THRESHOLD=0.85

# ─── Session Memory ──────────────────────────────────────────────────────────
SESSION_TTL=1800
SESSION_MAX_MESSAGES=5
SESSION_CONTENT_TRUNCATE=500

# ─── Long-Term Memory (pgvector) ─────────────────────────────────────────────
LTM_DAYS=7
LTM_THRESHOLD=0.88
LTM_DIFF_THRESHOLD=0.7
LTM_DIFF_LIMIT=5
IVFFLAT_LISTS=100

# ─── Job Queue (Redis Streams) ───────────────────────────────────────────────
STREAM_KEY=research:jobs
CONSUMER_GROUP=workers
RESULT_TTL=3600

# ─── Agent Pipeline Tuning ───────────────────────────────────────────────────
AGENT_REPORT_TRUNCATE=3000
AGENT_MAX_ITERATIONS=2

# ─── Evaluation Tuning ───────────────────────────────────────────────────────
EVAL_REPORT_TRUNCATE=1500
EVAL_COMMENT_TRUNCATE=300

# ─── LLM Retry ───────────────────────────────────────────────────────────────
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=1.0

# ─── Rate Limiting (per IP) ──────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60

# ─── Database Connection Pool ────────────────────────────────────────────────
DB_POOL_MIN=2
DB_POOL_MAX=10
